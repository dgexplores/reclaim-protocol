# Address printed by `npx hardhat run scripts/deploy.js --network baseSepolia`
NEXT_PUBLIC_CONTRACT_ADDRESS=0x...
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.lighthouse.storage/ipfs/

# Server-side only. Never prefix this with NEXT_PUBLIC_, that would ship your
# key to every browser that loads the page.
LIGHTHOUSE_API_KEY=
