# Address printed by `npx hardhat run scripts/deploy.js --network baseSepolia`
NEXT_PUBLIC_CONTRACT_ADDRESS=0x...
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# IPFS pinning. Server-side only. Never prefix these with NEXT_PUBLIC_, that
# would ship the key to every browser that loads the page.
# Set either one. Pinata is tried first and is reachable on more networks;
# Lighthouse is blocked outright by some ISPs.
PINATA_JWT=
LIGHTHOUSE_API_KEY=
